<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://www.algonquincollege.com/cst8259/labs"
  xmlns="http://www.algonquincollege.com/cst8259/labs"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

	<!-- ===================== SIMPLE TYPES ===================== -->

	<!-- Postal code: A1A 1A1 (space optional) -->
	<xs:simpleType name="CanadianPostalCodeType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z]\d[A-Za-z][ ]?\d[A-Za-z]\d"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Province/Territory codes -->
	<xs:simpleType name="CanadianProvinceCodeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AB"/>
			<xs:enumeration value="BC"/>
			<xs:enumeration value="MB"/>
			<xs:enumeration value="NB"/>
			<xs:enumeration value="NL"/>
			<xs:enumeration value="NS"/>
			<xs:enumeration value="ON"/>
			<xs:enumeration value="PE"/>
			<xs:enumeration value="QC"/>
			<xs:enumeration value="SK"/>
			<xs:enumeration value="NT"/>
			<xs:enumeration value="NU"/>
			<xs:enumeration value="YT"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Price tier 1..4 -->
	<xs:simpleType name="Tier1to4">
		<xs:restriction base="xs:unsignedByte">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="4"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Optional: restrict display text a bit (can leave as string if you want) -->
	<xs:simpleType name="PriceDisplayType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="40"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- ===================== (c) GLOBAL ADDRESS ===================== -->

	<xs:element name="address" type="AddressType"/>

	<xs:complexType name="AddressType">
		<xs:sequence>
			<xs:element name="street" type="xs:string"/>
			<xs:element name="city" type="xs:string"/>
			<xs:element name="province" type="CanadianProvinceCodeType"/>
			<xs:element name="postalCode" type="CanadianPostalCodeType"/>
			<xs:element name="country" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>

	<!-- ===================== (b) GLOBAL MENU ITEM ===================== -->

	<xs:element name="item" type="MenuItemType"/>

	<xs:complexType name="MenuItemType">
		<xs:sequence>
			<xs:element name="name" type="xs:string"/>

			<xs:element name="dietary" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="tag" type="xs:string" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="description" type="xs:string" minOccurs="0"/>
			<xs:element name="pricing" type="PricingType"/>
		</xs:sequence>

		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>

	<!-- ===================== SUPPORTING TYPES ===================== -->

	<xs:complexType name="LogoType">
		<xs:sequence>
			<xs:element name="url" type="xs:string"/>

			<xs:element name="width">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:unsignedShort">
							<xs:attribute name="unit" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>

			<xs:element name="height">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:unsignedShort">
							<xs:attribute name="unit" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PhoneType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="countryCode" type="xs:unsignedByte" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="PricingType">
		<xs:sequence>
			<xs:element name="serving">
				<xs:complexType>
					<xs:attribute name="quantity" type="xs:decimal" use="required"/>
					<xs:attribute name="unit" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>

			<xs:element name="price">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:decimal">
							<xs:attribute name="currency" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>

			<xs:element name="priceBasis" type="xs:string"/>

			<xs:element name="pricePerItem" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:decimal">
							<xs:attribute name="currency" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="ReviewType">
		<xs:sequence>
			<xs:element name="date">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:date">
							<xs:attribute name="format" type="xs:string" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>

			<xs:element name="reviewer" type="xs:string"/>

			<xs:element name="rating">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:unsignedByte">
							<xs:attribute name="outOf" type="xs:unsignedByte" use="required"/>
						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>

			<xs:element name="summary" type="xs:string"/>

			<xs:element name="menu">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="section" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element ref="item" maxOccurs="unbounded"/>
								</xs:sequence>
								<xs:attribute name="name" type="xs:string" use="required"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>

		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>

	<xs:complexType name="RestaurantType">
		<xs:sequence>
			<xs:element name="name" type="xs:string"/>
			<xs:element name="website" type="xs:string"/>
			<xs:element name="logo" type="LogoType"/>

			<xs:element name="contact">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="phone" type="PhoneType"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="location">
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="address"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element name="cuisine" type="xs:string"/>

			<xs:element name="price">
				<xs:complexType>
					<xs:attribute name="tier" type="Tier1to4" use="required"/>
					<xs:attribute name="minTier" type="xs:unsignedByte" use="required" fixed="1"/>
					<xs:attribute name="maxTier" type="xs:unsignedByte" use="required" fixed="4"/>
					<xs:attribute name="display" type="PriceDisplayType" use="required"/>
				</xs:complexType>
			</xs:element>

			<xs:element name="review" type="ReviewType"/>
		</xs:sequence>

		<xs:attribute name="id" type="xs:string" use="required"/>
	</xs:complexType>

	<!-- ===================== (a) GLOBAL ROOT ===================== -->

	<xs:element name="restaurantReviews">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="restaurant" type="RestaurantType" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="version" type="xs:decimal" use="required"/>
			<xs:attribute name="generatedOn" type="xs:date" use="required"/>
		</xs:complexType>
	</xs:element>

</xs:schema>