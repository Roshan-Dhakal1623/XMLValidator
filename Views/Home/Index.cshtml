@model XMLValidator.Models.XmlValidationViewModel

<div class="container mt-4" style="max-width:760px;">
    <h1 class="text-center mb-4">XML Validator</h1>

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="p-4 border rounded bg-white">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row mb-3 align-items-center">
            <label class="col-4 col-form-label">@Html.DisplayNameFor(m => m.SchemaFile)</label>
            <div class="col-8">
                <input asp-for="SchemaFile" type="file" class="form-control" />
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label class="col-4 col-form-label">@Html.DisplayNameFor(m => m.XmlFile)</label>
            <div class="col-8">
                <input asp-for="XmlFile" type="file" class="form-control" />
            </div>
        </div>

        <div class="text-center">
            <button class="btn btn-primary px-4" type="submit">Upload</button>
        </div>
    </form>
</div>
