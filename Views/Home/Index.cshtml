@model IEnumerable<Lab3.Models.RestaurantOverviewViewModel>

<h2>Restaurants Overview</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.First().Name)</th>
            <th>@Html.DisplayNameFor(m => m.First().FoodType)</th>
            <th>@Html.DisplayNameFor(m => m.First().Rating)</th>
            <th>@Html.DisplayNameFor(m => m.First().Cost)</th>
            <th>@Html.DisplayNameFor(m => m.First().City)</th>
            <th>@Html.DisplayNameFor(m => m.First().ProvinceState)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.FoodType</td>
                <td>@item.Rating</td>
                <td>@item.Cost</td>
                <td>@item.City</td>
                <td>@item.ProvinceState</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
