@model XMLValidator.Models.XmlValidationViewModel
@using System.Linq

@{
    ViewData["Title"] = "Validation Results";
}

<div class="xml-results-page">
    <h1 class="xml-page-title">Validation Results</h1>

    @if (Model == null || !Model.Errors.Any())
    {
        <div class="xml-card">
            <p>No errors were found when validating the XML file <strong>@Model?.XmlFileName</strong> against the schema <strong>@Model?.XsdFileName</strong>.</p>
        </div>
    }
    else
    {
        <div class="xml-card">
            <table class="table xml-table mb-0">
                <thead>
                    <tr>
                        <th>Element</th>
                        <th>Error Type</th>
                        <th>Line</th>
                        <th>Column</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var error in Model.Errors)
                    {
                        <tr>
                            <td>@error.Element</td>
                            <td>@error.ErrorType</td>
                            <td>@error.Line</td>
                            <td>@error.Column</td>
                            <td>@error.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
